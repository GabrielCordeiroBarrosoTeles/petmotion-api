# Copie para infra/.env na VPS e preencha. Nunca commite o .env.
APP_NAME=PetMotion
APP_ENV=production
# Gere com: docker compose run --rm petmotion-php php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://petmotion.tolembrado.com.br
APP_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/database.sqlite

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Senha das contas com acesso ao monitor (admin@petmotion.app e cordeiro@suporte.com)
# usada pelo ./deploy.sh --seed. Em servidor público, use uma senha forte.
SEED_ADMIN_PASSWORD=

# Páginas de Privacidade e Termos
LEGAL_NAME=PetMotion
LEGAL_EMAIL=
LEGAL_DPO_NAME=
LEGAL_DOCUMENT=
LEGAL_CITY=

# Passeio ao vivo (Reverb, container petmotion-reverb na porta interna 8096).
# Gere valores próprios, um por linha:
#   REVERB_APP_ID:     openssl rand -hex 8
#   REVERB_APP_KEY:    openssl rand -hex 16
#   REVERB_APP_SECRET: openssl rand -hex 32
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Endereço público, o que o app usa (wss://petmotion.tolembrado.com.br/app/<chave>)
REVERB_HOST=petmotion.tolembrado.com.br
REVERB_PORT=443
REVERB_SCHEME=https
# Onde o Reverb escuta dentro do container
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8096
# Onde o Laravel publica os eventos: direto no container, sem sair da rede interna
REVERB_PUBLISH_HOST=petmotion-reverb
REVERB_PUBLISH_PORT=8096
REVERB_PUBLISH_SCHEME=http
